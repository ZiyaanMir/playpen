# textmapworld_graphreasoning -- explore the map AND answer questions about the
# graph you have built up while doing it.
#
# Same shape as textmapworld.env in every respect that matters to this file: a
# single learner seat (GameSpec players = 1, the PathDescriber is programmatic), the
# same max_turns = 20 dataclass default in master.py, and the same one-line
# `GO: DIRECTION` / `DONE` move format. Read textmapworld.env's header for the two
# consequences -- it is NOT self-play, and GRPO's signal is the 8 replays of one map.
#
# The difference is what the model must ALSO produce: graph-reasoning answers, which
# are a sentence rather than a directive. That is why MAX_COMPLETION_LENGTH is not
# cut as far here as the pure-navigation variants would allow.

GAME=textmapworld_graphreasoning

# DEVIATES FROM THE SHARED BLOCK: 1024 -> 512 (see textmapworld.env: 20 turns x 1024
# is a ~20k-token row). 512 comfortably covers a reasoning answer plus a move.
MAX_COMPLETION_LENGTH=512

# --- memory sizing (identical to textmapworld.env; see it for the arithmetic) --
# DEVIATES FROM THE SHARED BLOCK: PER_DEVICE_BATCH 4 -> 2, GRAD_ACCUM 16 -> 32,
# VLLM_MAX_MODEL_LEN 16384 -> 24576. Sized against the MAX_TURNS ceiling
# (40 x 512 ~= 20k tokens), not the typical episode. PER_DEVICE_BATCH x GRAD_ACCUM
# stays 64, so the MARSHAL advantage pool is unchanged.
NUM_GENERATIONS=8
PER_DEVICE_BATCH=2
GRAD_ACCUM=32
GRAD_CKPT=1
VLLM_UTIL=0.30
VLLM_MAX_MODEL_LEN=24576

# --- schedule ----------------------------------------------------------------
MAX_STEPS=1000
SAVE_STEPS=100
LEARNING_RATE=1e-5
KL_BETA=0.0
# Safety ceiling only: the game self-limits at 20 rounds; MAX_TURNS counts
# LEARNER-controlled turns, and a re-prompt costs one.
MAX_TURNS=40

# --- splitting this run across several jobs ----------------------------------
# MAX_STEPS above is the TOTAL for the run, whatever the job layout. TRAIN_SEGMENTS
# only decides how many chained jobs those steps are handed out over -- each resumes
# the previous one's checkpoint, and every one of them trains under the same
# --max-steps, so the LR schedule is unchanged. Left unset (= 1 job) here, because
# the right number depends on the cluster's walltime, not on the game:
#
#   TRAIN_SEGMENTS=3 experiments/<cluster>/run_experiment.sh textmapworld_graphreasoning
#
# See "Long runs: segments and resuming" in experiments/README.md.
# TRAIN_SEGMENTS=1

# --- evaluation --------------------------------------------------------------
EVAL_TASKS=logiglue,logicbench
EVAL_BATCH=auto

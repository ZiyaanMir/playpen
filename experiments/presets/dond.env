# dond (Deal or No Deal) -- negotiation, 2 seats.
#
# Episode shape: clembench/dond/in/instances.json sets max_turns = 5, so a seat
# takes ~5 turns per episode. That matters for the length penalty, which is charged
# PER TURN and summed by the backward cumulative return -- what competes with the
# +-1 game outcome is 5 x the per-turn penalty, not the per-turn number.

GAME=dond

# Per-turn generation budget. A negotiation message (a split proposal plus its
# justification) is wordier than a yes/no, hence more than guesswhat's 512.
MAX_COMPLETION_LENGTH=1024

# --- length penalty ----------------------------------------------------------
# Calibrated 2026-07-23. Generation is hard-capped per turn at
# MAX_COMPLETION_LENGTH, so a turn can never exceed it; setting LP_MAX_LEN near
# the cap (as the YAML comment used to advise) makes the penalty unreachable and
# therefore inert. MARSHAL's design point is "about -coef at 2x max_len", which is
# only reachable when the cap is >= 2 x max_len:
#
#     LP_MAX_LEN = MAX_COMPLETION_LENGTH / 2        -> -coef at a fully saturated turn
#     LP_COEF    = target_episode_total / turns     -> 0.52 / 5 ~= 0.10
#
# Gives -0.103 per capped turn, ~-0.52 per episode against a +-1 outcome: strong
# enough to matter, structurally unable to beat winning the game.
LP_MAX_LEN=384
LP_COEF=0.10

# --- memory sizing -----------------------------------------------------------
# A rollout row is the WHOLE flattened episode for one seat, so
# seq_len ~= rounds x MAX_COMPLETION_LENGTH, and TRL materializes fp32 logits at
# batch x seq_len x 151936 (Qwen3 vocab) x 4 bytes -- doubled by the KL_BETA
# reference forward. PER_DEVICE_BATCH x GRAD_ACCUM stays 16 so the MARSHAL
# per-seat advantage pool is unchanged; only the per-forward micro-batch shrinks.
NUM_GENERATIONS=8
PER_DEVICE_BATCH=4
GRAD_ACCUM=16
GRAD_CKPT=1
VLLM_UTIL=0.30
VLLM_MAX_MODEL_LEN=16384

# --- schedule ----------------------------------------------------------------
MAX_STEPS=700
SAVE_STEPS=100
LEARNING_RATE=1e-5
KL_BETA=0.0
# Safety ceiling only: dond self-limits at 5 rounds (~10-12 env turns).
MAX_TURNS=30

# --- evaluation --------------------------------------------------------------
EVAL_TASKS=logiglue,logicbench
EVAL_BATCH=auto

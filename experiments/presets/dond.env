# dond (Deal or No Deal) -- negotiation, 2 seats.
#
# Episode shape: clembench/dond/in/instances.json sets max_turns = 5, so a seat
# takes ~5 turns per episode.

GAME=dond

# Per-turn generation budget. A negotiation message (a split proposal plus its
# justification) is wordier than a yes/no, hence more than guesswhat's 512.
MAX_COMPLETION_LENGTH=1024

# --- memory sizing -----------------------------------------------------------
# A rollout row is the WHOLE flattened episode for one seat, so
# seq_len ~= rounds x MAX_COMPLETION_LENGTH, and TRL materializes fp32 logits at
# batch x seq_len x 151936 (Qwen3 vocab) x 4 bytes -- doubled by the KL_BETA
# reference forward. PER_DEVICE_BATCH x GRAD_ACCUM stays 16 so the MARSHAL
# per-seat advantage pool is unchanged; only the per-forward micro-batch shrinks.
NUM_GENERATIONS=8
PER_DEVICE_BATCH=4
GRAD_ACCUM=16
GRAD_CKPT=1
VLLM_UTIL=0.30
VLLM_MAX_MODEL_LEN=16384

# --- schedule ----------------------------------------------------------------
MAX_STEPS=1000
SAVE_STEPS=100
LEARNING_RATE=1e-5
KL_BETA=0.0
# Safety ceiling only: dond self-limits at 5 rounds (~10-12 env turns).
MAX_TURNS=30

# --- splitting this run across several jobs ----------------------------------
# MAX_STEPS above is the TOTAL for the run, whatever the job layout. TRAIN_SEGMENTS
# only decides how many chained jobs those steps are handed out over -- each resumes
# the previous one's checkpoint, and every one of them trains under the same
# --max-steps, so the LR schedule is unchanged. Left unset (= 1 job) here, because
# the right number depends on the cluster's walltime, not on the game:
#
#   TRAIN_SEGMENTS=3 experiments/<cluster>/run_experiment.sh dond
#
# See "Long runs: segments and resuming" in experiments/README.md.
TRAIN_SEGMENTS=2

# --- evaluation --------------------------------------------------------------
EVAL_TASKS=logiglue,logicbench
EVAL_BATCH=auto

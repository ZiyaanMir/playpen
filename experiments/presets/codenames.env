# codenames -- word-association, 2 seats (Cluegiver + Guesser).
#
# A genuine 2-player game, verified against clembench (players = 2, roles
# "Cluegiver"/"Guesser"), so it is structurally identical to guesswhat and taboo:
# two asymmetric seats driven by one shared LoRA policy, with MARSHAL's per-seat
# normalization active. Smoke-tested through the port: dataset builds seat0+seat1
# rows, reset/observe/reward all work.
#
# Episode shape: the Cluegiver gives a one-word clue, the Guesser guesses one or
# more of its team's words; play continues over several rounds until the team's
# words are found or a wrong/assassin guess ends it. clembench does not expose an
# explicit max_turns in the instance, so turns_per_seat is ESTIMATED at ~4 below.

GAME=codenames

MAX_COMPLETION_LENGTH=1024

# --- length penalty ----------------------------------------------------------
# Same rule as the other presets: LP_MAX_LEN = MAX_COMPLETION_LENGTH / 2 (reachable
# against the per-turn generation cap), LP_COEF = target_episode_total / turns.
#
# UNVERIFIED: turns_per_seat is estimated (~4), so LP_COEF ~= 0.45 / 4. A Cluegiver
# turn (one clue + reasoning) is short-to-moderate; the penalty will bite only if
# the policy pads its reasoning. Check marshal/length_penalty/mean on the first run
# and retune, exactly as for the other games (see experiments/README.md).
LP_MAX_LEN=512
LP_COEF=0.11

# --- memory sizing (identical to the other presets) --------------------------
# A rollout row is the WHOLE flattened episode for one seat, so
# seq_len ~= turns x MAX_COMPLETION_LENGTH, and TRL materializes fp32 logits at
# batch x seq_len x 151936 (Qwen3 vocab) x 4 bytes -- doubled by the KL_BETA
# reference forward. PER_DEVICE_BATCH x GRAD_ACCUM = 64 is the MARSHAL per-seat pool
# (8 distinct prompts / step); only the per-forward micro-batch is PER_DEVICE_BATCH.
NUM_GENERATIONS=8
PER_DEVICE_BATCH=4
GRAD_ACCUM=16
GRAD_CKPT=1
VLLM_UTIL=0.30
VLLM_MAX_MODEL_LEN=16384

# --- schedule ----------------------------------------------------------------
MAX_STEPS=500
SAVE_STEPS=100
LEARNING_RATE=1e-5
KL_BETA=0.2
# Safety ceiling only: codenames self-limits after a handful of rounds.
MAX_TURNS=20

# --- evaluation --------------------------------------------------------------
EVAL_TASKS=logiglue,logicbench
EVAL_BATCH=auto

# hot_air_balloon (clembench dir air_balloon_survival) -- two survivors negotiate
# which items to throw out of a sinking balloon.
#
# A genuine 2-player game, verified against clembench through the port (players = 2,
# both seats Negotiator, both model driven; SelfPlayEnv builds both seats and
# reset/observe/step/reward all work). Same family as dond: asymmetric preferences,
# a shared outcome, per-seat normalization live.
#
# *** THIS GAME HAS NO BUILT-IN ROUND LIMIT. *** Unlike dond (max_turns = 5) or
# guesswhat (8), air_balloon_survival/master.py ends an episode only on agreement or
# on `successive_empty_turns > empty_turn_limit` (8 in every packaged instance, with
# patience = 2). So MAX_TURNS below is NOT a formality -- it is the only thing
# stopping a stalling pair of seats.
#
# WHY THAT MATTERS. The rollout loop is `while not env.done and turn < max_turns`,
# so hitting MAX_TURNS truncates the episode BEFORE clembench awards its terminal
# +-1. A truncated episode's return is 0, and a batch of them is the zero-advantage
# degenerate case: no gradient, and the training log looks fine. Watch the fraction
# of episodes that end on the cap, and raise MAX_TURNS (with the memory sizing) if
# it is not small.

GAME=hot_air_balloon

# A negotiation message carries a proposal, an argument and (in the strategic
# reasoning experiments) an explicit reasoning block -- the wordiest turn of any
# game here. Same 1024 as dond.
MAX_COMPLETION_LENGTH=1024

# --- length penalty ----------------------------------------------------------
# Same rule as the other presets: LP_MAX_LEN = MAX_COMPLETION_LENGTH / 2 (reachable
# against the per-turn cap), LP_COEF = target_episode_total / turns_per_seat.
#
# UNVERIFIED: with no round cap there is no packaged turn count to divide by, so
# turns_per_seat is taken as ~8 -- the empty_turn_limit, i.e. the longest a stalled
# negotiation can run before clembench gives up. 0.45 / 8 ~= 0.056.
#
# This game is the one where the penalty is most likely to BITE rather than sit at
# zero (long argued proposals), so check marshal/length_penalty/mean on the first
# run and retune before reading anything into an ablation.
LP_MAX_LEN=512
LP_COEF=0.056

# --- memory sizing -----------------------------------------------------------
# DEVIATES FROM THE SHARED BLOCK: PER_DEVICE_BATCH 4 -> 2, GRAD_ACCUM 16 -> 32,
# VLLM_MAX_MODEL_LEN 16384 -> 24576.
#
# A rollout row is the WHOLE flattened episode for one seat, so
# seq_len ~= turns x MAX_COMPLETION_LENGTH, and TRL materializes fp32 logits at
# batch x seq_len x 151936 (Qwen3 vocab) x 4 bytes. The sizing has to cover the
# MAX_TURNS ceiling rather than a typical episode, because there is no round cap to
# fall back on: 20 turns per seat x 1024 ~= 20k tokens. Micro-batch halved to keep
# the per-forward token budget near where guesswhat verified it (~32k tokens);
# PER_DEVICE_BATCH x GRAD_ACCUM stays 64, so the MARSHAL per-seat advantage pool is
# unchanged.
NUM_GENERATIONS=8
PER_DEVICE_BATCH=2
GRAD_ACCUM=32
GRAD_CKPT=1
VLLM_UTIL=0.30
VLLM_MAX_MODEL_LEN=24576

# --- schedule ----------------------------------------------------------------
MAX_STEPS=1000
SAVE_STEPS=100
LEARNING_RATE=1e-5
KL_BETA=0.0
# NOT a safety ceiling -- a real cap (see the header). 40 learner turns is ~20 per
# seat, well past the 8-successive-empty-turn abort but bounded enough that one
# stalling pair cannot eat a step.
MAX_TURNS=40

# --- splitting this run across several jobs ----------------------------------
# LONG EPISODES: this game's rollouts are among the slowest in the suite, so
# 1000 steps is a real risk of running out of walltime in one job (Eddie caps
# h_rt at 48 h, Isambard --time at 24 h, and neither cap can be raised).
#
# MAX_STEPS above is the TOTAL for the run whatever the job layout. TRAIN_SEGMENTS
# only decides how many chained jobs those steps are handed out over -- each resumes
# the previous one's checkpoint, and every one of them trains under the same
# --max-steps, so the LR schedule is unchanged and a segmented arm stays comparable
# with an unsegmented one.
#
#   TRAIN_SEGMENTS=3 experiments/<cluster>/run_experiment.sh hot_air_balloon
#
# Left unset (= 1 job) so nothing changes for a run that already fits; set it on the
# command line, or uncomment below. If a run does die part-way, nothing is lost --
# experiments/<cluster>/resume_experiment.sh <EXP_DIR> picks it up from its last
# checkpoint. See "Long runs: segments and resuming" in experiments/README.md.
TRAIN_SEGMENTS=10

# --- evaluation --------------------------------------------------------------
EVAL_TASKS=logiglue,logicbench
EVAL_BATCH=auto

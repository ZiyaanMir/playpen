# wordle -- 5-letter word guessing.
#
# *** SINGLE-PLAYER GAME (players = 1). *** Verified against clembench: wordle has
# one role, "Guesser". This runs through the port unchanged -- SelfPlayEnv and the
# rollout code are written N-seat generic, and were smoke-tested at num_players=1
# (dataset builds one seat-0 row per instance; reset/observe/reward all work) --
# but two things follow that you should know:
#
#   1. It is NOT self-play. There is no opponent and no second seat, so
#      `agent_specific_normalization` (MARSHAL's headline per-seat pooling) has a
#      single pool and does nothing. What you actually get is single-agent GRPO
#      with MARSHAL's turn-level credit + whitening (+ length penalty), which is a
#      legitimate setup -- just don't describe a wordle run as MARSHAL self-play.
#   2. GRPO still works: NUM_GENERATIONS=8 replays the same target word 8 times and
#      compares those 8 attempts, which is the learning signal here.
#
# Episode shape: the guesser gets "six attempts" (from the packaged prompt), so
# turns_per_seat ~= 6. Each turn is one short "explanation:/guess:" line.

GAME=wordle

MAX_COMPLETION_LENGTH=1024

# --- length penalty ----------------------------------------------------------
# Same rule as the other presets: LP_MAX_LEN = MAX_COMPLETION_LENGTH / 2 (so the
# penalty is reachable -- a turn is hard-capped at the completion length), and
# LP_COEF = target_episode_total / turns ~= 0.45 / 6.
#
# UNVERIFIED against a real run, and almost certainly INERT here: a wordle turn is
# one short line (a five-letter guess plus a sentence of explanation), far under
# 512 tokens, so the penalty will essentially never fire. That is the honest result
# for this game (nothing to shorten), not a wiring bug -- watch
# marshal/length_penalty/mean, and consider --no-length-penalty for a cleaner run.
LP_MAX_LEN=512
LP_COEF=0.075

# --- memory sizing (identical to the other presets) --------------------------
# A rollout row is the WHOLE flattened episode for one seat, so
# seq_len ~= turns x MAX_COMPLETION_LENGTH, and TRL materializes fp32 logits at
# batch x seq_len x 151936 (Qwen3 vocab) x 4 bytes -- doubled by the KL_BETA
# reference forward. Wordle rows are short (~6 brief turns), so this is the least
# memory-hungry of the games.
NUM_GENERATIONS=8
PER_DEVICE_BATCH=4
GRAD_ACCUM=16
GRAD_CKPT=1
VLLM_UTIL=0.30
VLLM_MAX_MODEL_LEN=16384

# --- schedule ----------------------------------------------------------------
MAX_STEPS=700
SAVE_STEPS=100
LEARNING_RATE=1e-5
KL_BETA=0.0
# Safety ceiling only: wordle self-limits at 6 guesses.
MAX_TURNS=20

# --- evaluation --------------------------------------------------------------
EVAL_TASKS=logiglue,logicbench
EVAL_BATCH=auto

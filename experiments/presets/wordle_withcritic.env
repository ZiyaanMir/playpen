# wordle_withcritic -- wordle where a second model criticises each guess before it
# is committed.
#
# A genuine 2-seat game and, unlike wordle_withclue, both seats really are model
# driven: wordle/master.py's WordleWithCritic._add_players() adds a
# ReflectingWordGuesser AND a WordCritic. Probed through the port: possible_agents
# == ["player_0", "player_1"], both LLM players. Per-seat normalization is live.
#
# Episode shape, and why it is the longest of the wordle family. Each round runs
# guesser -> critic -> guesser (the `awaiting_critic` / `commit_guess` machinery in
# _should_pass_turn / _does_game_proceed), and common_config sets n_turns = 6. So
# per episode: ~12 guesser turns, ~6 critic turns, ~18 learner turns total. The two
# seats therefore have genuinely DIFFERENT turn counts and different token mass --
# see notes on seat token-mass asymmetry before reading a per-seat metric as a
# per-seat effect.

GAME=wordle_withcritic

MAX_COMPLETION_LENGTH=1024

# --- length penalty ----------------------------------------------------------
# Same rule as the other presets (LP_MAX_LEN = cap/2), with LP_COEF divided by the
# LONGER seat's turn count so the penalty cannot dominate there:
#
#     episode total ~= turns x LP_COEF  ->  12 x 0.0375 ~= -0.45
#
# The critic seat takes ~6 turns and so accumulates ~-0.22 -- a real asymmetry, and
# the honest consequence of charging a per-turn penalty in a game whose seats do not
# move the same number of times.
#
# UNVERIFIED against a real run. Both roles write a short line plus a sentence of
# reasoning, so expect marshal/length_penalty/mean ~= 0.
LP_MAX_LEN=512
LP_COEF=0.0375

# --- memory sizing -----------------------------------------------------------
# DEVIATES FROM THE SHARED BLOCK: PER_DEVICE_BATCH 4 -> 2, GRAD_ACCUM 16 -> 32,
# VLLM_MAX_MODEL_LEN 16384 -> 24576.
#
# A rollout row is the WHOLE flattened episode for one seat, so
# seq_len ~= turns x MAX_COMPLETION_LENGTH = 12 x 1024 ~= 12k tokens for the guesser
# -- half again longer than guesswhat's 8k, and close enough to a 16384 context that
# the last turn's prompt (initial prompt + 11 prior exchanges + critic feedback)
# would not reliably fit. TRL materializes fp32 logits at
# batch x seq_len x 151936 (Qwen3 vocab) x 4 bytes, so the micro-batch is halved to
# keep the per-forward token budget where guesswhat verified it (~32k tokens).
# PER_DEVICE_BATCH x GRAD_ACCUM stays 64, so the MARSHAL per-seat advantage pool is
# unchanged -- only the per-forward micro-batch shrinks.
NUM_GENERATIONS=8
PER_DEVICE_BATCH=2
GRAD_ACCUM=32
GRAD_CKPT=1
VLLM_UTIL=0.30
VLLM_MAX_MODEL_LEN=24576

# --- schedule ----------------------------------------------------------------
MAX_STEPS=1000
SAVE_STEPS=100
LEARNING_RATE=1e-5
KL_BETA=0.0
# Safety ceiling only: 6 rounds x (guesser, critic, guesser) ~= 18 learner turns,
# plus clemcore re-prompts for invalid five-letter words.
MAX_TURNS=40

# --- splitting this run across several jobs ----------------------------------
# MAX_STEPS above is the TOTAL for the run, whatever the job layout. TRAIN_SEGMENTS
# only decides how many chained jobs those steps are handed out over -- each resumes
# the previous one's checkpoint, and every one of them trains under the same
# --max-steps, so the LR schedule is unchanged. Left unset (= 1 job) here, because
# the right number depends on the cluster's walltime, not on the game:
#
#   TRAIN_SEGMENTS=3 experiments/<cluster>/run_experiment.sh wordle_withcritic
#
# See "Long runs: segments and resuming" in experiments/README.md.
TRAIN_SEGMENTS=4

# --- evaluation --------------------------------------------------------------
EVAL_TASKS=logiglue,logicbench
EVAL_BATCH=auto

# textmapworld -- explore a graph of rooms exhaustively, one move at a time.
#
# *** SINGLE-SEAT GAME (GameSpec players = 1). *** clembench builds TWO clemcore
# players -- a PathGuesser (the model) and a PathDescriber -- but the describer is
# PROGRAMMATIC (it is constructed with a CustomResponseModel and just reports the
# room you arrived in). Verified through the port: possible_agents ==
# ["player_0", "player_1"] but GameSpec.players == 1, so SelfPlayEnv marks only
# seat 0 as "learner" and clemcore auto-steps the describer. That is the correct
# wiring -- the policy is never asked to write the describer's lines -- and it means
# the same two things wordle.env spells out:
#
#   1. It is NOT self-play. One learner seat means MARSHAL's per-seat pooling has a
#      single pool and does nothing. What you get is single-agent GRPO with MARSHAL's
#      turn-level credit + whitening (+ length penalty) -- a legitimate setup, just
#      not a self-play result.
#   2. GRPO still works: NUM_GENERATIONS=8 replays the same map 8 times and compares
#      those 8 explorations, which is the learning signal here.
#
# Episode shape: master.py fixes max_turns = 20 in TextmapworldGameState (a dataclass
# default; no packaged instance overrides it), and each turn is one short line --
# `GO: north` or `DONE`. So ~20 learner turns of a few tokens each, which is a lot of
# TURNS carrying very little text: the opposite profile from dond.

GAME=textmapworld

# DEVIATES FROM THE SHARED BLOCK: 1024 -> 512.
# 20 turns x 1024 is a ~20k-token row, past the 16384 context the other presets use,
# for responses that are literally five tokens long. 512 is still ~30x what a
# `GO: west` needs and keeps the row inside a sane context.
MAX_COMPLETION_LENGTH=512

# --- length penalty ----------------------------------------------------------
# Same rule as the other presets: LP_MAX_LEN = MAX_COMPLETION_LENGTH / 2 (reachable
# against the per-turn cap), LP_COEF = target_episode_total / turns ~= 0.45 / 20.
#
# UNVERIFIED and certain to be INERT: a turn is one directive. Expect
# marshal/length_penalty/mean ~= 0 -- the honest result for this game, not a wiring
# bug. --no-length-penalty is the cleaner MARSHAL-faithful arm here.
#
# NOTE the game's own score already rewards *fewer* moves ("visit all the rooms with
# the fewest number of room changes"), so brevity is priced into the outcome and does
# not need a second, token-level penalty on top.
LP_MAX_LEN=256
LP_COEF=0.0225

# --- memory sizing -----------------------------------------------------------
# DEVIATES FROM THE SHARED BLOCK: PER_DEVICE_BATCH 4 -> 2, GRAD_ACCUM 16 -> 32,
# VLLM_MAX_MODEL_LEN 16384 -> 24576.
#
# A rollout row is the WHOLE flattened episode for one seat, so
# seq_len ~= turns x MAX_COMPLETION_LENGTH, and TRL materializes fp32 logits at
# batch x seq_len x 151936 (Qwen3 vocab) x 4 bytes -- doubled by the KL_BETA
# reference forward. Sized against the MAX_TURNS ceiling (40 x 512 ~= 20k), not the
# typical episode, so a run that re-prompts its way past 20 rounds does not OOM.
# Micro-batch halved to keep the per-forward token budget near where guesswhat
# verified it (~32k tokens); PER_DEVICE_BATCH x GRAD_ACCUM stays 64, so the MARSHAL
# advantage pool is unchanged.
NUM_GENERATIONS=8
PER_DEVICE_BATCH=2
GRAD_ACCUM=32
GRAD_CKPT=1
VLLM_UTIL=0.30
VLLM_MAX_MODEL_LEN=24576

# --- schedule ----------------------------------------------------------------
MAX_STEPS=1000
SAVE_STEPS=100
LEARNING_RATE=1e-5
KL_BETA=0.0
# Safety ceiling only: the game self-limits at 20 rounds. MAX_TURNS counts
# LEARNER-controlled turns (the auto-stepped describer never returns control), and
# a re-prompt costs one, so 40 is 2x the round cap.
MAX_TURNS=40

# --- splitting this run across several jobs ----------------------------------
# MAX_STEPS above is the TOTAL for the run, whatever the job layout. TRAIN_SEGMENTS
# only decides how many chained jobs those steps are handed out over -- each resumes
# the previous one's checkpoint, and every one of them trains under the same
# --max-steps, so the LR schedule is unchanged. Left unset (= 1 job) here, because
# the right number depends on the cluster's walltime, not on the game:
#
#   TRAIN_SEGMENTS=3 experiments/<cluster>/run_experiment.sh textmapworld
#
# See "Long runs: segments and resuming" in experiments/README.md.
# TRAIN_SEGMENTS=1

# --- evaluation --------------------------------------------------------------
EVAL_TASKS=logiglue,logicbench
EVAL_BATCH=auto

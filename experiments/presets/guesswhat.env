# guesswhat -- 20-questions style, 2 seats.
#
# Episode shape: clembench/guesswhat/in/instances.json sets max_turns = 8, so a
# seat takes ~8 turns per episode -- more turns than dond, each one shorter.

GAME=guesswhat

# A question or a yes/no answer is short; 512 is ample.
MAX_COMPLETION_LENGTH=1024

# --- length penalty ----------------------------------------------------------
# Calibrated 2026-07-23, same rule as dond (LP_MAX_LEN = cap/2), but LP_COEF is
# HALF dond's because guesswhat has ~8 turns per seat instead of ~5 and the
# penalty is charged every turn:
#
#     episode total ~= turns x LP_COEF  ->  8 x 0.05 ~= -0.42
#
# Gives -0.052 per capped turn, ~-0.42 per episode against a +-1 outcome.
#
# NOTE the old setting (LP_MAX_LEN 500, LP_COEF 0.1) was numerically inert here:
# with a 512 cap the maximum reachable penalty was -0.0025 per turn, -0.02 per
# episode -- roughly zero against +-1. If you revert these, check
# marshal/length_penalty/mean in the logs, NOT over_rate (see README).
LP_MAX_LEN=256
LP_COEF=0.05

# --- memory sizing (see dond.env for the arithmetic) -------------------------
NUM_GENERATIONS=8
PER_DEVICE_BATCH=4
GRAD_ACCUM=16
GRAD_CKPT=1
VLLM_UTIL=0.30
VLLM_MAX_MODEL_LEN=16384

# --- schedule ----------------------------------------------------------------
MAX_STEPS=700
SAVE_STEPS=100
LEARNING_RATE=1e-5
KL_BETA=0.0
# Safety ceiling only: guesswhat self-limits at 8 rounds.
MAX_TURNS=30

# --- evaluation --------------------------------------------------------------
EVAL_TASKS=logiglue,logicbench
EVAL_BATCH=auto

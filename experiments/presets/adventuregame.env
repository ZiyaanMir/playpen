# adventuregame -- a single agent plays a text adventure to reach a goal state.
#
# *** SINGLE-PLAYER GAME (players = 1). *** Verified against clembench through the
# port: one role, "Adventurer", possible_agents == ["player_0"]. The same two
# consequences wordle.env spells out apply:
#
#   1. It is NOT self-play. One seat means MARSHAL's per-seat pooling has a single
#      pool and does nothing. What you get is single-agent GRPO with MARSHAL's
#      turn-level credit + whitening -- a legitimate setup, and
#      arguably the one this game is BEST suited to, because it is the longest-horizon
#      game in clembench and turn-level credit is exactly what long horizons need.
#   2. GRPO still works: NUM_GENERATIONS=8 replays the same adventure 8 times and
#      compares those 8 attempts.
#
# *** LONGEST EPISODES OF ANY GAME HERE. *** Every packaged instance carries its own
# max_turns: 50 for the four "home delivery / created" experiments, and **100** for
# potion_brewing. That is 2-20x every other game, and it drives every deviation
# below. A turn is one short command ("> open cupboard"), so this game is many
# turns carrying almost no text -- the extreme of the textmapworld profile.

GAME=adventuregame

# DEVIATES FROM THE SHARED BLOCK: 1024 -> 256.
# The packaged prompt is explicit -- "You write the single action you want to take
# in the game starting with >. Only reply with an action." -- so a turn is a handful
# of tokens. At 100 turns, 1024 would be a 100k-token row; 256 keeps the worst case
# at ~26k while still allowing 8x what an action needs.
MAX_COMPLETION_LENGTH=256

# --- memory sizing -----------------------------------------------------------
# DEVIATES FROM THE SHARED BLOCK: PER_DEVICE_BATCH 4 -> 1, GRAD_ACCUM 16 -> 64,
# VLLM_MAX_MODEL_LEN 16384 -> 32768.
#
# A rollout row is the WHOLE flattened episode for one seat, so
# seq_len ~= turns x MAX_COMPLETION_LENGTH, and TRL materializes fp32 logits at
# batch x seq_len x 151936 (Qwen3 vocab) x 4 bytes -- doubled by the KL_BETA
# reference forward. At the 100-turn ceiling that is 100 x 256 ~= 26k tokens in ONE
# row: roughly three guesswhat rows stacked. Hence micro-batch 1, which keeps the
# per-forward token budget (~26k) just under where guesswhat verified it (~32k).
# PER_DEVICE_BATCH x GRAD_ACCUM stays 64, so the MARSHAL advantage pool -- 8 distinct
# prompts x 8 generations per step -- is unchanged; only the per-forward micro-batch
# shrinks, at the cost of 64 sequential forwards per optimizer step. **Expect this to
# be the slowest game per step by a wide margin**; size the walltime accordingly.
NUM_GENERATIONS=8
PER_DEVICE_BATCH=1
GRAD_ACCUM=64
GRAD_CKPT=1
VLLM_UTIL=0.30
VLLM_MAX_MODEL_LEN=32768

# --- schedule ----------------------------------------------------------------
MAX_STEPS=1000
SAVE_STEPS=50
LEARNING_RATE=1e-5
KL_BETA=0.0
# Safety ceiling only: the instances self-limit at 50 or 100 turns. MAX_TURNS counts
# LEARNER-controlled turns, and this is a one-seat game, so 110 is just above the
# largest packaged max_turns.
MAX_TURNS=110

# --- splitting this run across several jobs ----------------------------------
# LONG EPISODES: this game's rollouts are among the slowest in the suite, so
# 500 steps is a real risk of running out of walltime in one job (Eddie caps
# h_rt at 48 h, Isambard --time at 24 h, and neither cap can be raised).
#
# MAX_STEPS above is the TOTAL for the run whatever the job layout. TRAIN_SEGMENTS
# only decides how many chained jobs those steps are handed out over -- each resumes
# the previous one's checkpoint, and every one of them trains under the same
# --max-steps, so the LR schedule is unchanged and a segmented arm stays comparable
# with an unsegmented one.
#
#   TRAIN_SEGMENTS=3 experiments/<cluster>/run_experiment.sh adventuregame
#
# Left unset (= 1 job) so nothing changes for a run that already fits; set it on the
# command line, or uncomment below. If a run does die part-way, nothing is lost --
# experiments/<cluster>/resume_experiment.sh <EXP_DIR> picks it up from its last
# checkpoint. See "Long runs: segments and resuming" in experiments/README.md.
TRAIN_SEGMENTS=10

# --- evaluation --------------------------------------------------------------
EVAL_TASKS=logiglue,logicbench
EVAL_BATCH=auto

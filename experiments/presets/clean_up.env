# clean_up -- two players negotiate a shared goal state and then arrange objects on
# a text grid to match it.
#
# TEXT-ONLY: clemgame.json's `clean_up` entry says image = "none". (The sibling
# entries `mm_clean_up`, `st_clean_up` and `hybrid_clean_up` in the same file ARE
# multimodal -- do not point this preset at those names.)
#
# *** PREREQUISITE: matplotlib MUST BE IN THE TRAINING VENV. ***
#   uv pip install matplotlib          (or: .venv/bin/pip install matplotlib)
# clembench/clean_up/resources/game_state/game_state.py imports it at module load,
# so without it the game cannot even be constructed:
#   ModuleNotFoundError: No module named 'matplotlib'
# raised from SelfPlayEnv's registry lookup, before a single episode runs. This is
# the same class of trap as privateshared needing scikit-learn (see
# experiments/README.md), and it is the reason this game could NOT be probed through
# the port here -- everything below is derived from the packaged instances and
# master.py, not from a live run. **Smoke-test it before committing a long run.**
#
# Episode shape: every packaged instance carries max_rounds, and the three values
# used are 12, 20 and 28. A round is both players, so the ceiling is ~28 turns per
# seat / ~56 learner turns.

GAME=clean_up

# DEVIATES FROM THE SHARED BLOCK: 1024 -> 512.
# A turn is a negotiation message or a placement instruction -- wordier than a
# textmapworld move, much shorter than a dond proposal. 28 turns x 1024 would be a
# ~29k-token row; 512 halves that while staying above what a placement needs.
MAX_COMPLETION_LENGTH=512

# --- length penalty ----------------------------------------------------------
# Same rule as the other presets: LP_MAX_LEN = MAX_COMPLETION_LENGTH / 2 (reachable
# against the per-turn cap), LP_COEF = target_episode_total / turns.
#
# UNVERIFIED, and the divisor is the MIDDLE of the three packaged round counts (20)
# rather than the ceiling, so a 12-round instance accumulates ~-0.27 and a 28-round
# one ~-0.63: 0.45 / 20 = 0.0225. Check marshal/length_penalty/mean on the first run
# -- the negotiation half of this game is the part likely to pad.
LP_MAX_LEN=256
LP_COEF=0.0225

# --- memory sizing -----------------------------------------------------------
# DEVIATES FROM THE SHARED BLOCK: PER_DEVICE_BATCH 4 -> 2, GRAD_ACCUM 16 -> 32,
# VLLM_MAX_MODEL_LEN 16384 -> 24576.
#
# A rollout row is the WHOLE flattened episode for one seat, so
# seq_len ~= turns x MAX_COMPLETION_LENGTH, and TRL materializes fp32 logits at
# batch x seq_len x 151936 (Qwen3 vocab) x 4 bytes -- doubled by the KL_BETA
# reference forward. Sized against the 28-round instances (28 x 512 ~= 14k tokens
# plus an accumulated context), not the 12-round ones. Micro-batch halved to keep the
# per-forward token budget near where guesswhat verified it (~32k tokens);
# PER_DEVICE_BATCH x GRAD_ACCUM stays 64, so the MARSHAL per-seat advantage pool is
# unchanged.
NUM_GENERATIONS=8
PER_DEVICE_BATCH=2
GRAD_ACCUM=32
GRAD_CKPT=1
VLLM_UTIL=0.30
VLLM_MAX_MODEL_LEN=24576

# --- schedule ----------------------------------------------------------------
MAX_STEPS=1000
SAVE_STEPS=100
LEARNING_RATE=1e-5
KL_BETA=0.0
# Safety ceiling only: the instances self-limit at 12/20/28 rounds, i.e. up to ~56
# LEARNER-controlled turns (both seats return control). 70 leaves room for re-prompts.
MAX_TURNS=70

# --- evaluation --------------------------------------------------------------
EVAL_TASKS=logiglue,logicbench
EVAL_BATCH=auto

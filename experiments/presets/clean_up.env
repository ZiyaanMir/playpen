# clean_up -- two players negotiate a shared goal state and then arrange objects on
# a text grid to match it.
#
# TEXT-ONLY: clemgame.json's `clean_up` entry says image = "none". (The sibling
# entries `mm_clean_up`, `st_clean_up` and `hybrid_clean_up` in the same file ARE
# multimodal -- do not point this preset at those names.)
#
# *** PREREQUISITE: matplotlib MUST BE IN THE TRAINING VENV. ***
#   uv pip install matplotlib          (or: .venv/bin/pip install matplotlib)
# clembench/clean_up/resources/game_state/game_state.py imports it at module load,
# so without it the game cannot even be constructed:
#   ModuleNotFoundError: No module named 'matplotlib'
# raised from SelfPlayEnv's registry lookup, before a single episode runs. This is
# the same class of trap as privateshared needing scikit-learn (see
# experiments/README.md), and it is the reason this game could NOT be probed through
# the port here -- everything below is derived from the packaged instances and
# master.py, not from a live run. **Smoke-test it before committing a long run.**
#
# Episode shape: every packaged instance carries max_rounds, and the three values
# used are 12, 20 and 28. A round is both players, so the ceiling is ~28 turns per
# seat / ~56 learner turns.

GAME=clean_up

# DEVIATES FROM THE SHARED BLOCK: 1024 -> 512.
# A turn is a negotiation message or a placement instruction -- wordier than a
# textmapworld move, much shorter than a dond proposal. 28 turns x 1024 would be a
# ~29k-token row; 512 halves that while staying above what a placement needs.
MAX_COMPLETION_LENGTH=512

# --- length penalty ----------------------------------------------------------
# Nothing to calibrate here any more. The penalty is a flat per-token cost with no
# threshold (every generated token is charged), and its per-EPISODE total is capped
# by length_penalty_budget, so a 3-turn game and a 50-turn game are bounded exactly
# the same way. The per-game LP_MAX_LEN / LP_COEF this block used to carry belonged
# to the old threshold-based penalty and are now inert -- they have been removed
# rather than left to look meaningful.
#
# It is still OFF by default (the MARSHAL-faithful setting for a free-text game).
# Turn it on for a run with EXTRA_TRAIN_ARGS=--length-penalty, and override the
# magnitude with LP_PER_TOKEN / LP_BUDGET if the default (-2e-5 per token, capped
# at -0.1 per episode against a +-1 outcome) is not what you want.
# See "The length penalty" in experiments/README.md.

# --- memory sizing -----------------------------------------------------------
# DEVIATES FROM THE SHARED BLOCK: PER_DEVICE_BATCH 4 -> 2, GRAD_ACCUM 16 -> 32,
# VLLM_MAX_MODEL_LEN 16384 -> 24576.
#
# A rollout row is the WHOLE flattened episode for one seat, so
# seq_len ~= turns x MAX_COMPLETION_LENGTH, and TRL materializes fp32 logits at
# batch x seq_len x 151936 (Qwen3 vocab) x 4 bytes -- doubled by the KL_BETA
# reference forward. Micro-batch halved to keep the per-forward token budget near
# where guesswhat verified it (~32k tokens); PER_DEVICE_BATCH x GRAD_ACCUM stays 64,
# so the MARSHAL per-seat advantage pool is unchanged.
NUM_GENERATIONS=8
PER_DEVICE_BATCH=2
GRAD_ACCUM=32
GRAD_CKPT=1
VLLM_UTIL=0.30

# 24576 -> 32768 (2026-08-17). THE OLD VALUE WAS TOO SMALL AND KILLED EVERY RUN.
# The first clean_up runs that got past the matplotlib prerequisite died mid-rollout at
# step 0 with
#   ValueError: The decoder prompt (length 24656) is longer than the maximum model
#              length of 24576
# i.e. 80 tokens over. The old sizing comment counted only the OWN generations
# (28 rounds x 512 ~= 14k) and treated the accumulated context as slack. It is not
# slack: a seat's prompt also carries every message the GM relays from the other
# player, so the real ceiling is roughly
#   initial prompt + 28 own turns x 512 + 28 relayed turns x 512  ~=  P + 28.7k
# which 24576 cannot hold whatever P is. Nothing truncates it either -- there is no
# prompt-length guard in selfplay_agent.py, so vLLM raises and the job dies.
#
# 32768 is not a guess: imagegame and adventuregame both run at 32768 with the same
# total generation budget (110 x 256 = 28160 vs 56 x 512 = 28672 here) and neither has
# ever hit this error. It also leaves 8k over the observed overflow point. If a longer
# instance still overflows, go to 40960 -- KV cache is not the constraint here (vLLM
# gets 0.30 x 140 GiB on an H200 and generation is ONE prompt at a time), so the only
# cost is a slightly smaller cache pool.
VLLM_MAX_MODEL_LEN=32768

# --- schedule ----------------------------------------------------------------
MAX_STEPS=1000
SAVE_STEPS=100
LEARNING_RATE=1e-5
KL_BETA=0.0
# Safety ceiling only: the instances self-limit at 12/20/28 rounds, i.e. up to ~56
# LEARNER-controlled turns (both seats return control). 70 leaves room for re-prompts.
MAX_TURNS=70

# --- splitting this run across several jobs ----------------------------------
# LONG EPISODES: this game's rollouts are among the slowest in the suite, so
# 1000 steps is a real risk of running out of walltime in one job (Eddie caps
# h_rt at 48 h, Isambard --time at 24 h, and neither cap can be raised).
#
# MAX_STEPS above is the TOTAL for the run whatever the job layout. TRAIN_SEGMENTS
# only decides how many chained jobs those steps are handed out over -- each resumes
# the previous one's checkpoint, and every one of them trains under the same
# --max-steps, so the LR schedule is unchanged and a segmented arm stays comparable
# with an unsegmented one.
#
#   TRAIN_SEGMENTS=3 experiments/<cluster>/run_experiment.sh clean_up
#
# Left unset (= 1 job) so nothing changes for a run that already fits; set it on the
# command line, or uncomment below. If a run does die part-way, nothing is lost --
# experiments/<cluster>/resume_experiment.sh <EXP_DIR> picks it up from its last
# checkpoint. See "Long runs: segments and resuming" in experiments/README.md.
TRAIN_SEGMENTS=10

# --- evaluation --------------------------------------------------------------
EVAL_TASKS=logiglue,logicbench
EVAL_BATCH=auto

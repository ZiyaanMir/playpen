# privateshared -- an assistant fills a form from a user's answers while a probe
# checks whether it can tell what it has been told from what it has only inferred.
#
# =============================================================================
#  DO NOT TRAIN ON THIS GAME THROUGH THIS PORT. This preset exists so the game is
#  documented and so `run_experiment.sh privateshared` fails informatively rather
#  than with "no preset for game". Two independent problems make a training run
#  here MEANINGLESS, not merely suboptimal. Both were read out of
#  clembench/privateshared/master.py; neither is fixable from a preset.
# =============================================================================
#
# (1) THE QUESTIONER IS PROGRAMMATIC AND THE PORT WOULD HAND IT TO THE POLICY.
#     master.py builds `Questioner(...)` with `super().__init__(CustomResponseModel())`
#     -- it replays a fixed `request_order` from the instance and is not a model at
#     all. But clemgame.json declares players = 2, SelfPlayEnv takes num_players from
#     the GameSpec, and it marks EVERY seat "learner". So the policy would be asked to
#     generate the scripted questions, and seat 1's rows would be trained on as if the
#     game had asked for them. (Contrast textmapworld, where GameSpec.players = 1
#     correctly leaves its programmatic describer to clemcore's auto-stepping.)
#
# (2) THE PROBING -- THE THING THE GAME SCORES -- BYPASSES THE ROLLOUT LOOP ENTIRELY.
#     `_probing_loop` calls `self.answerer(context, memorize=False)` DIRECTLY rather
#     than yielding through the PettingZoo agent loop. Under this port the answerer is
#     backed by the learner marker model, so a direct call falls through to
#     `Answerer._custom_response`, which returns a RANDOM string of the form
#     "<tag>yes, placeholder." Every probe would therefore be scored against a mock,
#     and the episode reward would be noise with respect to the policy.
#
# (3) Prerequisite either way: **scikit-learn must be in the venv** --
#     `from sklearn.metrics import accuracy_score` at the top of master.py -- or the
#     game cannot be imported. This is the same missing package that cost ~3.5 h of
#     GH200 aggregation on 2026-07-30 (see experiments/README.md).
#
# NONE OF THIS AFFECTS EVALUATION. `playpen eval` gives the answerer a real backend,
# so privateshared is scored normally as part of the `clem` suite -- it is only
# self-play TRAINING that is broken. Nothing here needs changing for job 3.
#
# Episode shape, for completeness: max_turns = len(request_order), and the packaged
# instances use 5 (travel-booking, job-interview, restaurant), 10 (letter-number) and
# 15 (things-places) requests, each round followed by a probing pass.

GAME=privateshared

# A form answer is one or two sentences; the probe answers are yes/no.
MAX_COMPLETION_LENGTH=512

# --- length penalty ----------------------------------------------------------
# Same rule as the other presets: LP_MAX_LEN = MAX_COMPLETION_LENGTH / 2,
# LP_COEF = target_episode_total / turns ~= 0.45 / 15 (the longest packaged
# request_order). UNVERIFIED and, given the header, untested by construction.
LP_MAX_LEN=256
LP_COEF=0.03

# --- memory sizing -----------------------------------------------------------
# DEVIATES FROM THE SHARED BLOCK: PER_DEVICE_BATCH 4 -> 2, GRAD_ACCUM 16 -> 32.
# A rollout row is the WHOLE flattened episode for one seat, so
# seq_len ~= turns x MAX_COMPLETION_LENGTH ~= 15 x 512 ~= 8k tokens; the micro-batch
# is halved for the same per-forward token budget the other long games use.
# PER_DEVICE_BATCH x GRAD_ACCUM stays 64, so the advantage pool is unchanged.
NUM_GENERATIONS=8
PER_DEVICE_BATCH=2
GRAD_ACCUM=32
GRAD_CKPT=1
VLLM_UTIL=0.30
VLLM_MAX_MODEL_LEN=16384

# --- schedule ----------------------------------------------------------------
MAX_STEPS=1000
SAVE_STEPS=100
LEARNING_RATE=1e-5
KL_BETA=0.0
# Safety ceiling only: up to 15 request rounds x 2 seats, plus the preliminary
# probing round.
MAX_TURNS=60

# --- splitting this run across several jobs ----------------------------------
# LONG EPISODES: this game's rollouts are among the slowest in the suite, so
# 1000 steps is a real risk of running out of walltime in one job (Eddie caps
# h_rt at 48 h, Isambard --time at 24 h, and neither cap can be raised).
#
# MAX_STEPS above is the TOTAL for the run whatever the job layout. TRAIN_SEGMENTS
# only decides how many chained jobs those steps are handed out over -- each resumes
# the previous one's checkpoint, and every one of them trains under the same
# --max-steps, so the LR schedule is unchanged and a segmented arm stays comparable
# with an unsegmented one.
#
#   TRAIN_SEGMENTS=3 experiments/<cluster>/run_experiment.sh privateshared
#
# Left unset (= 1 job) so nothing changes for a run that already fits; set it on the
# command line, or uncomment below. If a run does die part-way, nothing is lost --
# experiments/<cluster>/resume_experiment.sh <EXP_DIR> picks it up from its last
# checkpoint. See "Long runs: segments and resuming" in experiments/README.md.
TRAIN_SEGMENTS=10

# --- evaluation --------------------------------------------------------------
EVAL_TASKS=logiglue,logicbench
EVAL_BATCH=auto

# taboo -- word-guessing, 2 seats.
#
# Episode shape: clembench/taboo/in/instances.json sets max_turns = 3, the
# shortest of the three games. A turn is one CLUE or one GUESS -- a single short
# line -- so both the per-turn budget and the penalty threshold are small.

GAME=taboo

MAX_COMPLETION_LENGTH=1024

# --- length penalty ----------------------------------------------------------
# Same rule as the other presets (LP_MAX_LEN = cap/2), with LP_COEF raised because
# there are only ~3 turns per seat to accumulate over:
#
#     episode total ~= turns x LP_COEF  ->  3 x 0.15 ~= -0.45
#
# UNVERIFIED against a real run, unlike dond/guesswhat which were calibrated
# against observed turn lengths. taboo turns are naturally far under 128 tokens,
# so expect marshal/length_penalty/mean ~= 0 and over_rate ~= 0 -- for this game
# that is the honest result (nothing to penalize), not a wiring bug. Consider
# running taboo with --no-length-penalty as the cleaner MARSHAL-faithful arm.
LP_MAX_LEN=128
LP_COEF=0.15

# --- memory sizing -----------------------------------------------------------
# Rows are short here (3 turns x 256), so the fp32-logits pressure that forces
# batch 2 on dond/guesswhat is much lower and a bigger micro-batch fits.
NUM_GENERATIONS=8
PER_DEVICE_BATCH=4
GRAD_ACCUM=16
GRAD_CKPT=1
VLLM_UTIL=0.30
VLLM_MAX_MODEL_LEN=16384

# --- schedule ----------------------------------------------------------------
MAX_STEPS=1000
SAVE_STEPS=100
LEARNING_RATE=1e-5
KL_BETA=0.0
MAX_TURNS=20

# --- splitting this run across several jobs ----------------------------------
# MAX_STEPS above is the TOTAL for the run, whatever the job layout. TRAIN_SEGMENTS
# only decides how many chained jobs those steps are handed out over -- each resumes
# the previous one's checkpoint, and every one of them trains under the same
# --max-steps, so the LR schedule is unchanged. Left unset (= 1 job) here, because
# the right number depends on the cluster's walltime, not on the game:
#
#   TRAIN_SEGMENTS=3 experiments/<cluster>/run_experiment.sh taboo
#
# See "Long runs: segments and resuming" in experiments/README.md.
# TRAIN_SEGMENTS=1

# --- evaluation --------------------------------------------------------------
EVAL_TASKS=logiglue,logicbench
EVAL_BATCH=auto

# referencegame -- describe one of three ASCII grids so the other player can pick it.
#
# A genuine 2-player game, verified against clembench through the port
# (players = 2, roles "Instruction Giver"/"Instruction Follower"; SelfPlayEnv builds
# both seats, reset/observe/step/reward all work).
#
# Episode shape: **ONE ROUND** -- referencegame/master.py says so in as many words
# ("Game only has one round"). The giver writes an expression, the follower answers
# with which grid it means, and the episode ends. So turns_per_seat = 1 and an
# episode is 2 learner turns total.
#
# WHAT THAT MEANS FOR MARSHAL. With one turn per seat, the turn-level return
# collapses to the terminal reward -- there is nothing for the backward cumulative
# return to spread over, and the length penalty is charged exactly once. What still
# does work is the per-seat pooling and GRPO's comparison across NUM_GENERATIONS
# replays of the same instance. Use this game as the cheap, fast arm; do not present
# it as evidence about turn-level credit assignment.

GAME=referencegame

MAX_COMPLETION_LENGTH=1024

# --- length penalty ----------------------------------------------------------
# Nothing to calibrate here any more. The penalty is a flat per-token cost with no
# threshold (every generated token is charged), and its per-EPISODE total is capped
# by length_penalty_budget, so a 3-turn game and a 50-turn game are bounded exactly
# the same way. The per-game LP_MAX_LEN / LP_COEF this block used to carry belonged
# to the old threshold-based penalty and are now inert -- they have been removed
# rather than left to look meaningful.
#
# It is still OFF by default (the MARSHAL-faithful setting for a free-text game).
# Turn it on for a run with EXTRA_TRAIN_ARGS=--length-penalty, and override the
# magnitude with LP_PER_TOKEN / LP_BUDGET if the default (-2e-5 per token, capped
# at -0.1 per episode against a +-1 outcome) is not what you want.
# See "The length penalty" in experiments/README.md.

# --- memory sizing (identical to the other presets) --------------------------
# A rollout row is the WHOLE flattened episode for one seat, so
# seq_len ~= turns x MAX_COMPLETION_LENGTH, and TRL materializes fp32 logits at
# batch x seq_len x 151936 (Qwen3 vocab) x 4 bytes -- doubled by the KL_BETA
# reference forward. One turn per seat makes this the SHORTEST row of any game here
# (~1-2k tokens), so the shared sizing is comfortable rather than tight.
NUM_GENERATIONS=8
PER_DEVICE_BATCH=4
GRAD_ACCUM=16
GRAD_CKPT=1
VLLM_UTIL=0.30
VLLM_MAX_MODEL_LEN=16384

# --- schedule ----------------------------------------------------------------
MAX_STEPS=1000
SAVE_STEPS=100
LEARNING_RATE=1e-5
KL_BETA=0.0
# Safety ceiling only. MAX_TURNS counts LEARNER-controlled turns in the rollout loop
# (playpen/marshal/selfplay_agent.py: `while not env.done and turn < max_turns`), and
# referencegame needs exactly 2 of them; 10 leaves room for clemcore re-prompts.
MAX_TURNS=10

# --- splitting this run across several jobs ----------------------------------
# MAX_STEPS above is the TOTAL for the run, whatever the job layout. TRAIN_SEGMENTS
# only decides how many chained jobs those steps are handed out over -- each resumes
# the previous one's checkpoint, and every one of them trains under the same
# --max-steps, so the LR schedule is unchanged. Left unset (= 1 job) here, because
# the right number depends on the cluster's walltime, not on the game:
#
#   TRAIN_SEGMENTS=3 experiments/<cluster>/run_experiment.sh referencegame
#
# See "Long runs: segments and resuming" in experiments/README.md.
# TRAIN_SEGMENTS=1

# --- evaluation --------------------------------------------------------------
EVAL_TASKS=logiglue,logicbench
EVAL_BATCH=auto

# matchit_ascii -- two players compare ASCII grids they cannot both see and decide
# whether they hold the same picture.
#
# A genuine 2-player game, verified against clembench through the port (players = 2,
# roles "Player A"/"Player B"; SelfPlayEnv builds both seats, reset/observe/step/
# reward all work). Structurally the same shape as taboo/guesswhat: two asymmetric
# seats driven by one shared LoRA policy, per-seat normalization active.
#
# Episode shape: every packaged instance sets decision_turn = 3, and
# matchit_ascii/master.py ends the game one round later (`current_round ==
# decision_turn + 1`), so a seat takes ~5 turns: an opening grid description, a few
# rounds of questions/answers, then the decision. ~10 learner turns per episode.

GAME=matchit_ascii

# A grid description and a question-plus-answer are wordier than a yes/no but far
# short of an essay; 1024 matches the other two-seat presets.
MAX_COMPLETION_LENGTH=1024

# --- length penalty ----------------------------------------------------------
# Same rule as the other presets: LP_MAX_LEN = MAX_COMPLETION_LENGTH / 2 (so the
# penalty is reachable -- generation is hard-capped PER TURN at the completion
# length), and LP_COEF = target_episode_total / turns_per_seat ~= 0.45 / 5.
#
# Gives ~-0.09 per fully saturated turn, ~-0.45 per episode against a +-1 outcome:
# enough to matter, structurally unable to beat winning the game.
LP_MAX_LEN=512
LP_COEF=0.09

# --- memory sizing (see dond.env for the arithmetic) -------------------------
# ~5 turns x 1024 ~= 5k-token rows, between taboo and guesswhat, so the shared
# sizing carries over unchanged.
NUM_GENERATIONS=8
PER_DEVICE_BATCH=4
GRAD_ACCUM=16
GRAD_CKPT=1
VLLM_UTIL=0.30
VLLM_MAX_MODEL_LEN=16384

# --- schedule ----------------------------------------------------------------
MAX_STEPS=1000
SAVE_STEPS=100
LEARNING_RATE=1e-5
KL_BETA=0.0
# Safety ceiling only: matchit_ascii self-limits at decision_turn + 1 = 5 rounds
# (~10 learner turns). MAX_TURNS counts LEARNER-controlled turns, so 20 is 2x.
MAX_TURNS=20

# --- splitting this run across several jobs ----------------------------------
# MAX_STEPS above is the TOTAL for the run, whatever the job layout. TRAIN_SEGMENTS
# only decides how many chained jobs those steps are handed out over -- each resumes
# the previous one's checkpoint, and every one of them trains under the same
# --max-steps, so the LR schedule is unchanged. Left unset (= 1 job) here, because
# the right number depends on the cluster's walltime, not on the game:
#
#   TRAIN_SEGMENTS=3 experiments/<cluster>/run_experiment.sh matchit_ascii
#
# See "Long runs: segments and resuming" in experiments/README.md.
# TRAIN_SEGMENTS=1

# --- evaluation --------------------------------------------------------------
EVAL_TASKS=logiglue,logicbench
EVAL_BATCH=auto

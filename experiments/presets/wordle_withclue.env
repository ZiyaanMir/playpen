# wordle_withclue -- wordle where the guesser is handed a semantic clue.
#
# *** EFFECTIVELY A SINGLE-SEAT GAME, DESPITE players = 2. ***
#
# clembench's clemgame.json declares players = 2 with roles ["Guesser", "Clue
# Giver"], but wordle/master.py's WordleWithClue._add_players() adds ONE player --
# the clue comes from the instance (`target_word_clue`), not from a second model.
# Probed through the port: possible_agents == ["player_0"] while
# GameSpec.players == 2.
#
# THAT MISMATCH COSTS YOU HALF THE BATCH. SelfPlayEnv takes num_players from the
# GameSpec, so build_selfplay_dataset emits `{idx}::seat0` AND `{idx}::seat1` rows,
# and seat 1 never gets a turn: every seat-1 row comes back as a training-inert
# placeholder (owner_mask == [0], no gradient) carrying the terminal reward. So
# ~50% of every step's rows contribute nothing, per-seat pooling has an empty pool
# on one side, and the effective batch is half what the numbers below suggest.
#
# Prefer plain `wordle` (honestly 1 player, no wasted rows) unless the clue itself
# is the thing you want to study. If you do run this, read the step count as ~half
# an equivalent wordle run and do NOT describe it as two-seat self-play.
#
# Episode shape: common_config sets n_turns = 6, so the guesser gets six attempts,
# each one short "explanation:/guess:" block.

GAME=wordle_withclue

MAX_COMPLETION_LENGTH=1024

# --- memory sizing (identical to the other presets) --------------------------
# A rollout row is the WHOLE flattened episode for one seat, so
# seq_len ~= turns x MAX_COMPLETION_LENGTH: ~6 x 1024, the same as wordle, and the
# seat-1 placeholder rows are single-token. Nothing here needs to change.
NUM_GENERATIONS=8
PER_DEVICE_BATCH=4
GRAD_ACCUM=16
GRAD_CKPT=1
VLLM_UTIL=0.30
VLLM_MAX_MODEL_LEN=16384

# --- schedule ----------------------------------------------------------------
MAX_STEPS=1000
SAVE_STEPS=100
LEARNING_RATE=1e-5
KL_BETA=0.0
# Safety ceiling only: the game self-limits at 6 guesses (plus clemcore re-prompts
# for words that are not five letters).
MAX_TURNS=20

# --- splitting this run across several jobs ----------------------------------
# MAX_STEPS above is the TOTAL for the run, whatever the job layout. TRAIN_SEGMENTS
# only decides how many chained jobs those steps are handed out over -- each resumes
# the previous one's checkpoint, and every one of them trains under the same
# --max-steps, so the LR schedule is unchanged. Left unset (= 1 job) here, because
# the right number depends on the cluster's walltime, not on the game:
#
#   TRAIN_SEGMENTS=3 experiments/<cluster>/run_experiment.sh wordle_withclue
#
# See "Long runs: segments and resuming" in experiments/README.md.
TRAIN_SEGMENTS=4

# --- evaluation --------------------------------------------------------------
EVAL_TASKS=logiglue,logicbench
EVAL_BATCH=auto

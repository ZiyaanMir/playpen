# imagegame -- one player describes an ASCII grid cell by cell, the other draws it.
#
# TEXT-ONLY despite the name: clemgame.json says image = "none". The "image" is a
# 5x5 grid of letters and "▢" rendered as text.
#
# A genuine 2-player game, verified against clembench through the port (players = 2,
# roles "Instruction Giver"/"Instruction Follower", both model driven; SelfPlayEnv
# builds both seats and reset/observe/step/reward all work). Per-seat normalization
# is live, and the seats are strongly asymmetric -- the giver writes commands, the
# follower emits a grid.
#
# Episode shape, and the reason this file deviates most from the shared block:
# master.py sets max_rounds = grid_dimension^2 * 2, and every packaged instance is a
# 5x5 grid, so **max_rounds = 50**. A round is giver + follower, so the ceiling is
# ~50 turns per seat / ~100 learner turns per episode. Real episodes are shorter --
# the giver says "Command: DONE" once the grid is described, which is roughly one
# command per non-empty cell -- but the sizing below has to survive the ceiling.

GAME=imagegame

# DEVIATES FROM THE SHARED BLOCK: 1024 -> 256.
# A turn is one line: "Command: Put an E in second row third column", or the
# follower's 5x5 grid. 50 turns x 1024 would be a 51k-token row -- three times any
# context used here -- for text that never needs 100 tokens. 256 is still generous.
MAX_COMPLETION_LENGTH=256

# --- length penalty ----------------------------------------------------------
# Nothing to calibrate here any more. The penalty is a flat per-token cost with no
# threshold (every generated token is charged), and its per-EPISODE total is capped
# by length_penalty_budget, so a 3-turn game and a 50-turn game are bounded exactly
# the same way. The per-game LP_MAX_LEN / LP_COEF this block used to carry belonged
# to the old threshold-based penalty and are now inert -- they have been removed
# rather than left to look meaningful.
#
# It is still OFF by default (the MARSHAL-faithful setting for a free-text game).
# Turn it on for a run with EXTRA_TRAIN_ARGS=--length-penalty, and override the
# magnitude with LP_PER_TOKEN / LP_BUDGET if the default (-2e-5 per token, capped
# at -0.1 per episode against a +-1 outcome) is not what you want.
# See "The length penalty" in experiments/README.md.
#
# NOTE this game's own quality score already prefers describing the grid in FEWER
# commands, so brevity is priced into the outcome; leaving the penalty off is
# defensible here.

# --- memory sizing -----------------------------------------------------------
# DEVIATES FROM THE SHARED BLOCK: PER_DEVICE_BATCH 4 -> 2, GRAD_ACCUM 16 -> 32,
# VLLM_MAX_MODEL_LEN 16384 -> 32768.
#
# A rollout row is the WHOLE flattened episode for one seat, so
# seq_len ~= turns x MAX_COMPLETION_LENGTH, and TRL materializes fp32 logits at
# batch x seq_len x 151936 (Qwen3 vocab) x 4 bytes -- doubled by the KL_BETA
# reference forward. At the 50-round ceiling that is 50 x 256 ~= 13k tokens of
# completion plus a context that has accumulated all 50 exchanges, which is why the
# vLLM context is doubled rather than the row being allowed to overflow it.
# Micro-batch halved to keep the per-forward token budget near where guesswhat
# verified it (~32k tokens); PER_DEVICE_BATCH x GRAD_ACCUM stays 64, so the MARSHAL
# per-seat advantage pool is unchanged.
NUM_GENERATIONS=8
PER_DEVICE_BATCH=2
GRAD_ACCUM=32
GRAD_CKPT=1
VLLM_UTIL=0.30
VLLM_MAX_MODEL_LEN=32768

# --- schedule ----------------------------------------------------------------
MAX_STEPS=1000
SAVE_STEPS=100
LEARNING_RATE=1e-5
KL_BETA=0.0
# Safety ceiling only: the game self-limits at max_rounds = 5*5*2 = 50 rounds, i.e.
# ~100 LEARNER-controlled turns (both seats return control). 110 leaves room for
# clemcore re-prompts.
MAX_TURNS=110

# --- splitting this run across several jobs ----------------------------------
# LONG EPISODES: this game's rollouts are among the slowest in the suite, so
# 1000 steps is a real risk of running out of walltime in one job (Eddie caps
# h_rt at 48 h, Isambard --time at 24 h, and neither cap can be raised).
#
# MAX_STEPS above is the TOTAL for the run whatever the job layout. TRAIN_SEGMENTS
# only decides how many chained jobs those steps are handed out over -- each resumes
# the previous one's checkpoint, and every one of them trains under the same
# --max-steps, so the LR schedule is unchanged and a segmented arm stays comparable
# with an unsegmented one.
#
#   TRAIN_SEGMENTS=3 experiments/<cluster>/run_experiment.sh imagegame
#
# Left unset (= 1 job) so nothing changes for a run that already fits; set it on the
# command line, or uncomment below. If a run does die part-way, nothing is lost --
# experiments/<cluster>/resume_experiment.sh <EXP_DIR> picks it up from its last
# checkpoint. See "Long runs: segments and resuming" in experiments/README.md.
TRAIN_SEGMENTS=10

# --- evaluation --------------------------------------------------------------
EVAL_TASKS=logiglue,logicbench
EVAL_BATCH=auto
